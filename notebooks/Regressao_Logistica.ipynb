    "def_recalls = []\n",
    "nondef_recalls = []\n",
    "accs = []\n",
    "\n",
    "for val in thresh:\n",
    "    status = np.where(prob_default > val, 1, 0)\n",
    "    cm = confusion_matrix(y_test, status)\n",
    "    def_recalls.append(cm[1, 1] / (cm[1, 1] + cm[1, 0]))\n",
    "    nondef_recalls.append(cm[0, 0] / (cm[0, 0] + cm[0, 1]))\n",
    "    accs.append((cm[0, 0] + cm[1, 1]) / np.sum(cm))\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
